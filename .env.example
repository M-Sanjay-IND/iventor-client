# ============================================================================
# Inventor Client — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application
VITE_APP_URL=http://localhost:5173

# Counter Terminal
# Email domain restriction (empty = accept any email, e.g., "university.edu")
VITE_COUNTER_EMAIL_DOMAIN=
# Default loan period in days (empty = no due date, e.g., "14")
VITE_COUNTER_DUE_DAYS=
